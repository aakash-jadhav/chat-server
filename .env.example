PORT=5000
# Atlas (SRV — auto-resolved via public DNS if Windows SRV lookup fails):
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/secure-p2p-chat?retryWrites=true&w=majority
# Optional fallback if SRV still fails (Atlas → Connect → Drivers → standard connection string):
# MONGODB_URI_STANDARD=mongodb://<user>:<password>@host1:27017,host2:27017/secure-p2p-chat?ssl=true&authSource=admin
JWT_SECRET=change-this-to-a-long-random-secret-in-production
CLIENT_URL=http://localhost:5173
NODE_ENV=development
